# Server port (dev: 3000; the Docker stack exposes nginx on HTTP_PORT=80)
PORT=3000

# Set to 'production' to enable strict secrets checks + CSP headers
NODE_ENV=development

# Optional: enables Gemini AI Copilot features (triage, chat, NL->rules, phishing analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED IN PRODUCTION: JWT signing secrets.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Persistence (Phase 1). Leave unset to run with the in-memory store for dev.
# When set, the server auto-provisions schema + seed data on first boot.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://aegis:aegis_dev_password@localhost:5432/aegis
# Optional: cross-replica SSE fan-out + shared rate limiting. Graceful fallback.
REDIS_URL=redis://localhost:6379

# Seeded demo user passwords (defaults shown; override before first run)
SEED_ADMIN_PASSWORD=ChangeMe_Admin_2026!
SEED_ANALYST_PASSWORD=ChangeMe_Analyst_2026!
SEED_TRAINER_PASSWORD=ChangeMe_Trainer_2026!
SEED_VIEWER_PASSWORD=ChangeMe_Viewer_2026!

# Static API key for machine log forwarders (rsyslog/Vector) calling
# POST /api/telemetry/ingest with the 'x-api-key' header.
# If unset, ingest requires an authenticated user with telemetry:ingest permission.
INGEST_API_KEY=

# ---------------------------------------------------------------------------
# docker-compose overrides (read by docker-compose.yml; defaults shown)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=aegis_dev_password
HTTP_PORT=80