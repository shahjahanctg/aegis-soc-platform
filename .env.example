# Server port (locked to 3000)
PORT=3000

# Set to 'production' to enable strict secrets checks + CSP headers
NODE_ENV=development

# Optional: enables Gemini AI Copilot features (triage, chat, NL->rules, phishing analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED IN PRODUCTION: JWT signing secrets.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Seeded demo user passwords (defaults shown; override before first run)
SEED_ADMIN_PASSWORD=ChangeMe_Admin_2026!
SEED_ANALYST_PASSWORD=ChangeMe_Analyst_2026!
SEED_TRAINER_PASSWORD=ChangeMe_Trainer_2026!
SEED_VIEWER_PASSWORD=ChangeMe_Viewer_2026!

# Static API key for machine log forwarders (rsyslog/Vector) calling
# POST /api/telemetry/ingest with the 'x-api-key' header.
# If unset, ingest requires an authenticated user with telemetry:ingest permission.
INGEST_API_KEY=
