# ---------------------------------------------------------------------------
# AegisSOC — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Auth secrets (REQUIRED in production) -----------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-48

# --- Initial admin account (REQUIRED — no demo users are ever seeded) --------
# The platform provisions exactly one admin on first boot from these vars.
# Additional role-based accounts are created by an admin from Settings → User Management.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-strong-unique-password
ADMIN_NAME=Platform Administrator

# --- Optional integrations ----------------------------------------------------
# Machine log forwarders (rsyslog/Vector) authenticate to /api/telemetry/ingest
# and /api/analysis/ingest with this key. Platform users with telemetry:ingest
# permission can also call them with their JWT.
INGEST_API_KEY=

# Gemini AI API key (chat, triage, NL→rules, phishing, CTF hints).
# Can also be set/rotated at runtime from Settings → Gemini API (admin).
GEMINI_API_KEY=

# --- Persistence / infra -------------------------------------------------------
# When set, the server uses Postgres; otherwise an in-memory store (dev only).
DATABASE_URL=postgres://aegis:change-me@localhost:5432/aegis
REDIS_URL=redis://localhost:6379

# --- Docker compose (optional overrides) --------------------------------------
# HTTP_PORT=80
# POSTGRES_PASSWORD=change-me